{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
